# Producción: https://mercados.gpe.gob.mx
# Copie este archivo a /var/www/mercadopmg/.env y complete los valores marcados con CAMBIAR.

APP_NAME=GPE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mercados.gpe.gob.mx

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mexico_City

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mercadopmg
DB_USERNAME=mercadopmg
DB_PASSWORD=CAMBIAR

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=mercados.gpe.gob.mx

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correo para recuperación de contraseña (SMTP institucional).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CAMBIAR
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR
MAIL_PASSWORD=CAMBIAR
MAIL_FROM_ADDRESS="no-responder@gpe.gob.mx"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Administrador inicial (solo se usa en el primer db:seed).
# Si deja ADMIN_PASSWORD vacío se genera una aleatoria y se muestra una sola vez.
ADMIN_EMAIL=CAMBIAR@gpe.gob.mx
ADMIN_PASSWORD=
